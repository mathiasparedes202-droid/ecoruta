# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecoruta_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Entorno
APP_ENV=production
APP_NAME=EcoRuta

# URLs públicas
APP_URL=https://tu-backend.onrender.com
FRONTEND_URL=https://ecoruta.vercel.app
EcoRuta_URL=https://ecoruta.vercel.app

# JWT
JWT_SECRET=cambiar_por_un_secreto_seguro_de_64_caracteres
JWT_EXPIRE=3600

# Correo SMTP (opcional para recuperación de contraseña)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME=EcoRuta
