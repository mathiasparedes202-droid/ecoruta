# Copia a .env y completa. La SYNC_API_KEY debe ser IGUAL en backend/.env (local y web).
PORT=18650

# API local (XAMPP). Debe exponer /api/sync/* (migración 44 + SyncController).
LOCAL_BASE_URL=http://localhost:8000
LOCAL_SYNC_KEY=pon_la_misma_sync_api_key
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=ecoruta_db
LOCAL_DB_USER=root
LOCAL_DB_PASS=

# API web (tu servidor web con el mismo backend PHP desplegado).
WEB_BASE_URL=https://tu-servidor-web.com
WEB_SYNC_KEY=pon_la_misma_sync_api_key

# Cada cuántos segundos reintenta salud y sincroniza solo.
POLL_SECONDS=15
# Timeout para considerar caída la web (ms).
HEALTH_TIMEOUT_MS=8000
