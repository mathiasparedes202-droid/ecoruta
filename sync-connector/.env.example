HUB_URL=http://127.0.0.1:4000
SYSTEM_NAME=mi-sistema
SYSTEM_KEY=pon-la-clave-que-te-dio-el-hub
POLL_SECONDS=15
# Carpeta donde tu sistema deja archivos {items:[...]} para subir.
DROP_DIR=./data/drop
# Donde el conector guarda lo bajado del hub (auditoría).
INBOX_DIR=./data/inbox
# Donde mueve lo ya subido.
SENT_DIR=./data/sent
# Cursor del pull (archivo).
CURSOR_FILE=./data/cursor.txt
# Opcional: webhook local para auto-aplicar lo bajado (ej. tu API).
# Sin CALLBACK_URL solo guarda archivos en INBOX_DIR.
CALLBACK_URL=
